// ================================================================
// Finance — Firestore Security Rules
// Publicar en: Firebase Console → Firestore Database → Reglas
// (o vía Firebase CLI: firebase deploy --only firestore:rules)
// Cada usuario solo puede leer/escribir sus propios documentos,
// aislados por path (users/{uid}/...), equivalente a las políticas
// RLS que existían en Supabase.
// ================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
